# Copied in at build time by the pages workflow; never committed. Committing
# one would create a second copy of a source of truth that nothing checks:
# build_compat.py only compares compat.json against docs/compatibility.md, so a
# stale site/compat.json would drift silently.
site/catalog.json
site/compat.json
site/patterns.json
site/taxonomy.json
site/collections.json
# Rendered at deploy by scripts/render_images.py, from the data above.
site/stats.json
site/img/
site/.nojekyll

# Build output for awesome-jev-mcp. The wheel carries a snapshot of the three
# root JSON files, generated by force-include at build time — committing either
# the wheel or an unpacked _bundled/ would put a second copy of a source of
# truth in git, which is the drift this repository exists to avoid.
dist/
build/
*.egg-info/
src/awesome_jev_mcp/_bundled/

__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store
.idea/
.vscode/
.claude/
