# Copied in at build time by the pages workflow; never committed. Committing
# one would create a second copy of a source of truth that nothing checks:
# build_compat.py only compares compat.json against docs/compatibility.md, so a
# stale site/compat.json would drift silently.
site/catalog.json
site/compat.json
site/patterns.json
site/taxonomy.json
site/collections.json
site/picker.json
site/retired.json
site/schema/
site/llms.txt
# Written by scripts/assemble_site.py from the files above: one JSON file per
# decision pattern, for agents (scripts/site_api.py).
site/api/
# Written by scripts/assemble_site.py from the same files: plain pages per
# decision pattern, what's new, its feeds and the sitemap (scripts/site_pages.py).
site/patterns/
site/new.html
site/new.zh.html
site/feed.xml
site/feed.zh.xml
site/sitemap.xml
# Rendered at deploy by scripts/render_images.py, from the data above.
site/stats.json
site/img/
site/.nojekyll

# Build output for awesome-jev-mcp. The wheel carries a snapshot of the three
# root JSON files, generated by force-include at build time — committing either
# the wheel or an unpacked _bundled/ would put a second copy of a source of
# truth in git, which is the drift this repository exists to avoid.
dist/
build/
*.egg-info/
src/awesome_jev_mcp/_bundled/

# Draft catalog rows from `discover_candidates.py --drafts drafts`: a person's
# work in progress, which lint.py refuses until it is completed and moved into
# catalog.json. Never committed as they are.
/drafts/

__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store
.idea/
.vscode/
.claude/
