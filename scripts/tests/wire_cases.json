{
  "about": "What counts as an alternative row that records its interface (wire), whether a person has read its cited files, whether every cited file has a reading at all (a person's read_on or a model's model_read_on), and the GitHub owner/name printed beside its title (null off GitHub). scripts/wire.py and site/catalog-core.mjs both read these cases (scripts/tests/test_wire.py, scripts/test_catalog_core.mjs).",
  "cases": [
    {"name": "alternative with a wire record", "entry": {"slug": "a", "kind": "alternative", "url": "https://github.com/o/a", "wire": {"endpoint": "POST /v1/systemone", "source": [{"path": "s.py", "matched": ["/v1/systemone"]}]}}, "wired": true, "unwired": false, "person_read": false, "every_file_read": false, "repository": "o/a"},
    {"name": "every cited file read by a person", "entry": {"slug": "b", "kind": "alternative", "repo": "https://github.com/r/b", "url": "https://example.com/b", "wire": {"weights": "open", "source": [{"path": "s.py", "matched": ["x1"], "read_on": "2026-09-20"}, {"path": "t.py", "matched": ["y1"], "read_on": "2026-09-21"}]}}, "wired": true, "unwired": false, "person_read": true, "every_file_read": true, "repository": "r/b"},
    {"name": "one of two files read", "entry": {"slug": "c", "kind": "alternative", "url": "https://example.com/c", "wire": {"weights": "proxy", "source": [{"path": "s.py", "matched": ["x1"], "read_on": "2026-09-20"}, {"path": "t.py", "matched": ["y1"]}]}}, "wired": true, "unwired": false, "person_read": false, "every_file_read": false, "repository": null},
    {"name": "alternative without a wire record", "entry": {"slug": "d", "kind": "alternative", "url": "https://github.com/o/d/tree/main/server"}, "wired": false, "unwired": true, "person_read": false, "every_file_read": false, "repository": "o/d"},
    {"name": "wire that is not an object", "entry": {"slug": "e", "kind": "alternative", "wire": ["POST /v1/systemone"]}, "wired": false, "unwired": true, "person_read": false, "every_file_read": false, "repository": null},
    {"name": "wire null", "entry": {"slug": "f", "kind": "alternative", "wire": null}, "wired": false, "unwired": true, "person_read": false, "every_file_read": false, "repository": null},
    {"name": "wire on another kind is never listed or counted", "entry": {"slug": "g", "kind": "project", "wire": {"weights": "open", "source": [{"path": "s.py", "matched": ["x1"]}]}}, "wired": false, "unwired": false, "person_read": false, "every_file_read": false, "repository": null},
    {"name": "a project without wire", "entry": {"slug": "h", "kind": "project"}, "wired": false, "unwired": false, "person_read": false, "every_file_read": false, "repository": null},
    {"name": "a source item without matched is not a cited file", "entry": {"slug": "i", "kind": "alternative", "wire": {"weights": "open", "source": [{"path": "s.py", "read_on": "2026-09-20"}]}}, "wired": true, "unwired": false, "person_read": false, "every_file_read": false, "repository": null},
    {"name": "no source at all", "entry": {"slug": "j", "kind": "alternative", "wire": {"weights": "open"}}, "wired": true, "unwired": false, "person_read": false, "every_file_read": false, "repository": null},
    {"name": "every cited file read by a model", "entry": {"slug": "k", "kind": "alternative", "url": "https://github.com/o/k", "wire": {"weights": "open", "source": [{"path": "s.py", "matched": ["x1"], "model_read_on": "2026-10-24"}]}}, "wired": true, "unwired": false, "person_read": false, "every_file_read": true, "repository": "o/k"},
    {"name": "one file read by a person, the other only by a model", "entry": {"slug": "l", "kind": "alternative", "url": "https://github.com/o/l", "wire": {"weights": "proxy", "source": [{"path": "s.py", "matched": ["x1"], "read_on": "2026-09-20"}, {"path": "t.py", "matched": ["y1"], "model_read_on": "2026-10-24"}]}}, "wired": true, "unwired": false, "person_read": false, "every_file_read": true, "repository": "o/l"},
    {"name": "a person's reading beside a model's is a person's", "entry": {"slug": "m", "kind": "alternative", "url": "https://github.com/o/m", "wire": {"weights": "open", "source": [{"path": "s.py", "matched": ["x1"], "read_on": "2026-10-24", "model_read_on": "2026-10-20"}]}}, "wired": true, "unwired": false, "person_read": true, "every_file_read": true, "repository": "o/m"}
  ]
}
